# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#000000"

# Main text color
theme[main_fg]="#d7d7d7"

# Title color for boxes
theme[title]="#d7d7d7"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7d7d7d"

# Background color of selected item in processes box. #1a1a1a maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1a1a gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1a1a"

# Foreground color of selected item in processes box. Use #d7d7d7 so
# the row text stays readable on the lighter_bg highlight; the previous
# #7d7d7d produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#d7d7d7"

# Color of inactive/disabled text
theme[inactive_fg]="#686163"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #dddddd caps at #ffffff when the foreground is already pure white, so we
# just bind it to #d7d7d7 directly.
theme[graph_text]="#d7d7d7"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1a1a1a collapsed to the main fg.
theme[meter_bg]="#1a1a1a"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #d7d7d7 for a distinct accent instead of #dddddd which capped to white.
theme[proc_misc]="#d7d7d7"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#a9a9a9"
theme[mem_box]="#bfbfbf"
theme[net_box]="#939393"
theme[proc_box]="#7d7d7d"

# Box divider line and small boxes line color
theme[div_line]="#686163"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#bfbfbf"
theme[temp_mid]="#eeeeee"
theme[temp_end]="#939393"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#d7d7d7"
theme[cpu_mid]="#7d7d7d"
theme[cpu_end]="#a9a9a9"

# Mem/Disk free meter
theme[free_start]="#a9a9a9"
theme[free_mid]="#7d7d7d"
theme[free_end]="#d7d7d7"

# Mem/Disk cached meter
theme[cached_start]="#7d7d7d"
theme[cached_mid]="#d7d7d7"
theme[cached_end]="#a9a9a9"

# Mem/Disk available meter
theme[available_start]="#eeeeee"
theme[available_mid]="#939393"
theme[available_end]="#939393"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#bfbfbf"
theme[used_mid]="#d7d7d7"
theme[used_end]="#7d7d7d"

# Download graph colors
theme[download_start]="#eeeeee"
theme[download_mid]="#939393"
theme[download_end]="#939393"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#bfbfbf"
theme[upload_mid]="#d7d7d7"
theme[upload_end]="#7d7d7d"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#d7d7d7"
theme[process_mid]="#7d7d7d"
theme[process_end]="#a9a9a9"
