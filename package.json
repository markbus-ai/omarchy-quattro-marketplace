{
  "name": "omarchy-quattro-marketplace",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "copy-themes": "node -e \"const fs=require('fs'),path=require('path');const dirs=fs.readdirSync('themes').filter(d=>fs.statSync('themes/'+d).isDirectory());dirs.forEach(d=>{const pub='public/themes/'+d;fs.mkdirSync(pub,{recursive:true});const src='themes/'+d+'/preview.png';if(fs.existsSync(src))fs.copyFileSync(src,pub+'/preview.png');});console.log('Copied previews for',dirs.length,'themes')\"",
    "build": "npm run copy-themes && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "generate": "tsx scripts/generate-registry.ts",
    "validate": "tsx scripts/validate-themes.ts",
    "search:dev": "pagefind --site dist --serve",
    "intake": "node scripts/intake-submission.mjs",
    "validate-repo": "node scripts/validate-theme-repo.mjs",
    "publish-report": "node scripts/publish-report.mjs",
    "approve": "node scripts/approve-submission.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.4.1",
    "pagefind": "^1.5.2",
    "toml": "^5.0.0",
    "tsx": "^4.23.13",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
