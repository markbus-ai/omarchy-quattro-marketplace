    "validate-repo": "node scripts/validate-theme-repo.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.9",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@iarna/toml": "^2.2.5",
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.4.1",
    "pagefind": "^1.5.2",
    "toml": "^5.0.0",
    "tsx": "^4.23.13",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
