# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#140202"

# Main text color
theme[main_fg]="#FADAA3"

# Title color for boxes
theme[title]="#FADAA3"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#af6376"

# Background color of selected item in processes box. #2c1b1b maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #2c1b1b gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#2c1b1b"

# Foreground color of selected item in processes box. Use #FADAA3 so
# the row text stays readable on the lighter_bg highlight; the previous
# #af6376 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#FADAA3"

# Color of inactive/disabled text
theme[inactive_fg]="#635c5b"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #fbe0b1 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #FADAA3 directly.
theme[graph_text]="#FADAA3"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #2c1b1b collapsed to the main fg.
theme[meter_bg]="#2c1b1b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #ffcb62 for a distinct accent instead of #fbe0b1 which capped to white.
theme[proc_misc]="#ffcb62"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#eb898a"
theme[mem_box]="#f2b072"
theme[net_box]="#c37f6c"
theme[proc_box]="#af6376"

# Box divider line and small boxes line color
theme[div_line]="#635c5b"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#f2b072"
theme[temp_mid]="#ffd896"
theme[temp_end]="#c37f6c"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#ffcb62"
theme[cpu_mid]="#af6376"
theme[cpu_end]="#eb898a"

# Mem/Disk free meter
theme[free_start]="#eb898a"
theme[free_mid]="#af6376"
theme[free_end]="#ffcb62"

# Mem/Disk cached meter
theme[cached_start]="#af6376"
theme[cached_mid]="#ffcb62"
theme[cached_end]="#eb898a"

# Mem/Disk available meter
theme[available_start]="#ffd896"
theme[available_mid]="#c37f6c"
theme[available_end]="#c37f6c"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#f2b072"
theme[used_mid]="#ffcb62"
theme[used_end]="#af6376"

# Download graph colors
theme[download_start]="#ffd896"
theme[download_mid]="#c37f6c"
theme[download_end]="#c37f6c"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#f2b072"
theme[upload_mid]="#ffcb62"
theme[upload_end]="#af6376"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#ffcb62"
theme[process_mid]="#af6376"
theme[process_end]="#eb898a"
