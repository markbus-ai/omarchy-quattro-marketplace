# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0b011b"

# Main text color
theme[main_fg]="#ffb6ff"

# Title color for boxes
theme[title]="#ffb6ff"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7974b6"

# Background color of selected item in processes box. #231a32 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #231a32 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#231a32"

# Foreground color of selected item in processes box. Use #ffb6ff so
# the row text stays readable on the lighter_bg highlight; the previous
# #7974b6 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#ffb6ff"

# Color of inactive/disabled text
theme[inactive_fg]="#5e5c62"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #ffc1ff caps at #ffffff when the foreground is already pure white, so we
# just bind it to #ffb6ff directly.
theme[graph_text]="#ffb6ff"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #231a32 collapsed to the main fg.
theme[meter_bg]="#231a32"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #b0d3ff for a distinct accent instead of #ffc1ff which capped to white.
theme[proc_misc]="#b0d3ff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#b796e8"
theme[mem_box]="#8ec3ff"
theme[net_box]="#aa81b7"
theme[proc_box]="#7974b6"

# Box divider line and small boxes line color
theme[div_line]="#5e5c62"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#8ec3ff"
theme[temp_mid]="#ffccff"
theme[temp_end]="#aa81b7"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#b0d3ff"
theme[cpu_mid]="#7974b6"
theme[cpu_end]="#b796e8"

# Mem/Disk free meter
theme[free_start]="#b796e8"
theme[free_mid]="#7974b6"
theme[free_end]="#b0d3ff"

# Mem/Disk cached meter
theme[cached_start]="#7974b6"
theme[cached_mid]="#b0d3ff"
theme[cached_end]="#b796e8"

# Mem/Disk available meter
theme[available_start]="#ffccff"
theme[available_mid]="#aa81b7"
theme[available_end]="#aa81b7"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#8ec3ff"
theme[used_mid]="#b0d3ff"
theme[used_end]="#7974b6"

# Download graph colors
theme[download_start]="#ffccff"
theme[download_mid]="#aa81b7"
theme[download_end]="#aa81b7"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#8ec3ff"
theme[upload_mid]="#b0d3ff"
theme[upload_end]="#7974b6"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#b0d3ff"
theme[process_mid]="#7974b6"
theme[process_end]="#b796e8"
