# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#06080C"

# Main text color
theme[main_fg]="#D2A7B4"

# Title color for boxes
theme[title]="#D2A7B4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#7f7c9b"

# Background color of selected item in processes box. #1f2124 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1f2124 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1f2124"

# Foreground color of selected item in processes box. Use #D2A7B4 so
# the row text stays readable on the lighter_bg highlight; the previous
# #7f7c9b produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#D2A7B4"

# Color of inactive/disabled text
theme[inactive_fg]="#5c5f64"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #d9b4bf caps at #ffffff when the foreground is already pure white, so we
# just bind it to #D2A7B4 directly.
theme[graph_text]="#D2A7B4"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1f2124 collapsed to the main fg.
theme[meter_bg]="#1f2124"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #cad9ff for a distinct accent instead of #d9b4bf which capped to white.
theme[proc_misc]="#cad9ff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#b4a4ca"
theme[mem_box]="#aec5e5"
theme[net_box]="#a28ea6"
theme[proc_box]="#7f7c9b"

# Box divider line and small boxes line color
theme[div_line]="#5c5f64"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#aec5e5"
theme[temp_mid]="#ffe2fe"
theme[temp_end]="#a28ea6"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#cad9ff"
theme[cpu_mid]="#7f7c9b"
theme[cpu_end]="#b4a4ca"

# Mem/Disk free meter
theme[free_start]="#b4a4ca"
theme[free_mid]="#7f7c9b"
theme[free_end]="#cad9ff"

# Mem/Disk cached meter
theme[cached_start]="#7f7c9b"
theme[cached_mid]="#cad9ff"
theme[cached_end]="#b4a4ca"

# Mem/Disk available meter
theme[available_start]="#ffe2fe"
theme[available_mid]="#a28ea6"
theme[available_end]="#a28ea6"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#aec5e5"
theme[used_mid]="#cad9ff"
theme[used_end]="#7f7c9b"

# Download graph colors
theme[download_start]="#ffe2fe"
theme[download_mid]="#a28ea6"
theme[download_end]="#a28ea6"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#aec5e5"
theme[upload_mid]="#cad9ff"
theme[upload_end]="#7f7c9b"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#cad9ff"
theme[process_mid]="#7f7c9b"
theme[process_end]="#b4a4ca"
