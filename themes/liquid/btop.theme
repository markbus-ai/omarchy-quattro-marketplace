# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#11100C"

# Main text color
theme[main_fg]="#DEF1F4"

# Title color for boxes
theme[title]="#DEF1F4"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#667dcb"

# Background color of selected item in processes box. #292824 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #292824 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#292824"

# Foreground color of selected item in processes box. Use #DEF1F4 so
# the row text stays readable on the lighter_bg highlight; the previous
# #667dcb produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#DEF1F4"

# Color of inactive/disabled text
theme[inactive_fg]="#6b6a63"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #e3f3f6 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #DEF1F4 directly.
theme[graph_text]="#DEF1F4"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #292824 collapsed to the main fg.
theme[meter_bg]="#292824"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #60bdee for a distinct accent instead of #e3f3f6 which capped to white.
theme[proc_misc]="#60bdee"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#6f76c6"
theme[mem_box]="#b27731"
theme[net_box]="#b46f38"
theme[proc_box]="#667dcb"

# Box divider line and small boxes line color
theme[div_line]="#6b6a63"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#b27731"
theme[temp_mid]="#c69647"
theme[temp_end]="#b46f38"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#60bdee"
theme[cpu_mid]="#667dcb"
theme[cpu_end]="#6f76c6"

# Mem/Disk free meter
theme[free_start]="#6f76c6"
theme[free_mid]="#667dcb"
theme[free_end]="#60bdee"

# Mem/Disk cached meter
theme[cached_start]="#667dcb"
theme[cached_mid]="#60bdee"
theme[cached_end]="#6f76c6"

# Mem/Disk available meter
theme[available_start]="#c69647"
theme[available_mid]="#b46f38"
theme[available_end]="#b46f38"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#b27731"
theme[used_mid]="#60bdee"
theme[used_end]="#667dcb"

# Download graph colors
theme[download_start]="#c69647"
theme[download_mid]="#b46f38"
theme[download_end]="#b46f38"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#b27731"
theme[upload_mid]="#60bdee"
theme[upload_end]="#667dcb"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#60bdee"
theme[process_mid]="#667dcb"
theme[process_end]="#6f76c6"
