# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#010025"

# Main text color
theme[main_fg]="#E1E5FC"

# Title color for boxes
theme[title]="#E1E5FC"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#8071b3"

# Background color of selected item in processes box. #1a1a3b maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #1a1a3b gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#1a1a3b"

# Foreground color of selected item in processes box. Use #E1E5FC so
# the row text stays readable on the lighter_bg highlight; the previous
# #8071b3 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#E1E5FC"

# Color of inactive/disabled text
theme[inactive_fg]="#595b61"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #e6e9fc caps at #ffffff when the foreground is already pure white, so we
# just bind it to #E1E5FC directly.
theme[graph_text]="#E1E5FC"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #1a1a3b collapsed to the main fg.
theme[meter_bg]="#1a1a3b"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #bdcfff for a distinct accent instead of #e6e9fc which capped to white.
theme[proc_misc]="#bdcfff"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#bf93e2"
theme[mem_box]="#97c0ff"
theme[net_box]="#af80b1"
theme[proc_box]="#8071b3"

# Box divider line and small boxes line color
theme[div_line]="#595b61"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#97c0ff"
theme[temp_mid]="#ffcbff"
theme[temp_end]="#af80b1"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#bdcfff"
theme[cpu_mid]="#8071b3"
theme[cpu_end]="#bf93e2"

# Mem/Disk free meter
theme[free_start]="#bf93e2"
theme[free_mid]="#8071b3"
theme[free_end]="#bdcfff"

# Mem/Disk cached meter
theme[cached_start]="#8071b3"
theme[cached_mid]="#bdcfff"
theme[cached_end]="#bf93e2"

# Mem/Disk available meter
theme[available_start]="#ffcbff"
theme[available_mid]="#af80b1"
theme[available_end]="#af80b1"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#97c0ff"
theme[used_mid]="#bdcfff"
theme[used_end]="#8071b3"

# Download graph colors
theme[download_start]="#ffcbff"
theme[download_mid]="#af80b1"
theme[download_end]="#af80b1"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#97c0ff"
theme[upload_mid]="#bdcfff"
theme[upload_end]="#8071b3"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#bdcfff"
theme[process_mid]="#8071b3"
theme[process_end]="#bf93e2"
