---
/**
 * SearchInput.astro — Debounced text search input with live results count.
 *
 * Features:
 * - 300ms debounce on input
 * - aria-label for accessibility
 * - aria-live region announces results count
 * - Dispatches "filter-change" CustomEvent on the document
 */

interface Props {
  /** Total number of themes before filtering */
  totalCount: number;
}

const { totalCount } = Astro.props;
---

<div class="relative">
  <label for="theme-search" class="sr-only">Search themes</label>
  <div class="relative">
    <svg
      class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2"
      stroke="currentColor"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
      />
    </svg>
    <input
      id="theme-search"
      type="search"
      placeholder="Search themes by name, author, or tag…"
      aria-label="Search themes"
      class="w-full rounded-lg border border-border bg-surface py-2.5 pl-10 pr-4 text-sm text-foreground placeholder-muted-foreground focus:border-accent focus:outline-none focus:ring-2 focus:ring-accent/30"
      data-search-input
    />
  </div>
  <div
    aria-live="polite"
    aria-atomic="true"
    class="mt-2 text-sm text-muted-foreground"
    data-search-status
  >
    Showing {totalCount} of {totalCount} themes
  </div>
</div>

<script>
  function initSearchInput() {
    const input = document.querySelector('[data-search-input]') as HTMLInputElement;
    const status = document.querySelector('[data-search-status]') as HTMLElement;
    if (!input || !status) return;

    let debounceTimer: ReturnType<typeof setTimeout>;

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const query = input.value.trim();
        document.dispatchEvent(
          new CustomEvent('filter-change', {
            detail: { search: query },
            bubbles: true,
          })
        );
      }, 300);
    });
  }

  // Run on initial load and after Astro view transitions
  initSearchInput();
  document.addEventListener('astro:page-load', initSearchInput);
</script>
