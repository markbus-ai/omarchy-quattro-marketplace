---
/**
 * PaletteGrid.astro — Renders a 24-color palette as a grid of accessible swatches.
 *
 * Each swatch is focusable (tabindex="0"), has an aria-label with the color name
 * and hex value, and shows a tooltip on hover/focus.
 */

import { PALETTE_KEYS, type Palette } from '../data/theme-schema';

interface Props {
  palette: Palette;
  /** Size variant: "sm" for cards, "lg" for detail pages */
  size?: 'sm' | 'lg';
  /** Unique ID to namespace event handlers */
  id?: string;
}

const { palette, size = 'sm', id } = Astro.props;
const gridId = id ?? `palette-${Math.random().toString(36).slice(2, 8)}`;

/** Human-readable labels for each palette key. */
const LABELS: Record<string, string> = {
  background: 'Background',
  foreground: 'Foreground',
  cursor: 'Cursor',
  selection_foreground: 'Selection Foreground',
  selection_background: 'Selection Background',
  border: 'Border',
  color0: 'Black',
  color1: 'Red',
  color2: 'Green',
  color3: 'Yellow',
  color4: 'Blue',
  color5: 'Magenta',
  color6: 'Cyan',
  color7: 'White',
  color8: 'Bright Black',
  color9: 'Bright Red',
  color10: 'Bright Green',
  color11: 'Bright Yellow',
  color12: 'Bright Blue',
  color13: 'Bright Magenta',
  color14: 'Bright Cyan',
  color15: 'Bright White',
  accent: 'Accent',
};

/** Compute relative luminance for contrast calculation. */
function luminance(hex: string): number {
  const r = parseInt(hex.slice(1, 3), 16) / 255;
  const g = parseInt(hex.slice(3, 5), 16) / 255;
  const b = parseInt(hex.slice(5, 7), 16) / 255;

  const toLinear = (c: number) =>
    c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);

  return 0.2126 * toLinear(r) + 0.7152 * toLinear(g) + 0.0722 * toLinear(b);
}

/** Determine if text on this background should be dark or light. */
function textColor(hex: string): string {
  return luminance(hex) > 0.4 ? '#000000' : '#ffffff';
}

const swatchSize = size === 'lg' ? 'w-12 h-12' : 'w-7 h-7';
---

<ul
  id={gridId}
  class:list={[
    'grid gap-1.5',
    size === 'lg' ? 'grid-cols-6 sm:grid-cols-8' : 'grid-cols-6',
  ]}
  aria-label="Color palette"
>
  {PALETTE_KEYS.map((key) => {
    const hex = palette[key];
    const label = LABELS[key] ?? key;
    const fg = textColor(hex);

    return (
      <li class="relative">
        <span
          class:list={[
            swatchSize,
            'block rounded-sm border border-border/50 transition-transform',
            'hover:scale-125 hover:z-10',
          ]}
          style={`background-color: ${hex}; color: ${fg};`}
          data-swatch-tooltip={`${label}: ${hex}`}
        >
          {size === 'lg' && (
            <span class="sr-only">{label}</span>
          )}
        </span>
      </li>
    );
  })}
</ul>

<script>
  function initPaletteGrids() {
    document.querySelectorAll<HTMLElement>('[id^="palette-"]').forEach((grid) => {
      let tooltip: HTMLDivElement | null = null;

      function hide() {
        if (tooltip) {
          tooltip.remove();
          tooltip = null;
        }
      }

      function show(swatch: HTMLElement) {
        hide();
        const text = swatch.dataset.swatchTooltip;
        if (!text) return;

        tooltip = document.createElement('div');
        tooltip.textContent = text;
        tooltip.className =
          'pointer-events-none absolute bottom-full left-1/2 z-50 mb-2 -translate-x-1/2 whitespace-nowrap rounded bg-surface px-2 py-1 text-xs text-foreground shadow-lg border border-border';
        tooltip.setAttribute('role', 'tooltip');

        const li = swatch.closest('li')!;
        li.appendChild(tooltip);
      }

      grid.addEventListener('mouseover', (e) => {
        const swatch = (e.target as HTMLElement).closest('[data-swatch-tooltip]');
        if (swatch) show(swatch as HTMLElement);
      });

      grid.addEventListener('mouseout', (e) => {
        const swatch = (e.target as HTMLElement).closest('[data-swatch-tooltip]');
        if (swatch) {
          const related = e.relatedTarget as HTMLElement | null;
          if (!related || !related.closest || !related.closest('[data-swatch-tooltip]')) {
            hide();
          }
        }
      });

      grid.addEventListener('focusin', (e) => {
        const swatch = (e.target as HTMLElement).closest('[data-swatch-tooltip]');
        if (swatch) show(swatch as HTMLElement);
      });

      grid.addEventListener('focusout', () => hide());
    });
  }

  initPaletteGrids();
  document.addEventListener('astro:page-load', initPaletteGrids);
</script>
