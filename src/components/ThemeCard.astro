---
/**
 * ThemeCard.astro — A card displaying theme preview, name, author, mood tags, palette, and stats.
 *
 * Features:
 * - Quick Look preview on hover (full wallpaper overlay)
 * - Color family badge with dot
 * - Inferred stats (palette diversity, contrast, warmth)
 * - Share button
 * - Links to theme detail page
 */

import PaletteGrid from './PaletteGrid.astro';
import type { ThemeRegistryEntry } from '../data/schema';

interface Props {
  theme: ThemeRegistryEntry;
}

const { theme } = Astro.props;

/** Color dot for the color family badge */
const colorDots: Record<string, string> = {
  red: '#ef4444',
  orange: '#f97316',
  yellow: '#eab308',
  green: '#22c55e',
  cyan: '#06b6d4',
  blue: '#3b82f6',
  purple: '#a855f7',
  pink: '#ec4899',
  neutral: '#71717a',
};

/** Infer stats from palette */
function inferStats(palette: Record<string, string>) {
  // Count unique hue families in ANSI colors
  const hues = new Set<string>();
  for (let i = 1; i <= 6; i++) {
    const hex = palette[`color${i}`];
    if (!hex) continue;
    const r = parseInt(hex.slice(1, 3), 16);
    const g = parseInt(hex.slice(3, 5), 16);
    const b = parseInt(hex.slice(5, 7), 16);
    const max = Math.max(r, g, b);
    const min = Math.min(r, g, b);
    if (max - min < 30) { hues.add('neutral'); continue; }
    if (r > g && r > b) hues.add('red');
    else if (g > r && g > b) hues.add('green');
    else if (b > r && b > g) hues.add('blue');
    else if (r > b && g > b) hues.add('yellow');
    else if (r > g && b > g) hues.add('magenta');
    else hues.add('cyan');
  }

  // Contrast ratio (approximate)
  const bg = palette.background || '#000000';
  const fg = palette.foreground || '#ffffff';
  const bgL = 0.299 * parseInt(bg.slice(1, 3), 16) + 0.587 * parseInt(bg.slice(3, 5), 16) + 0.114 * parseInt(bg.slice(5, 7), 16);
  const fgL = 0.299 * parseInt(fg.slice(1, 3), 16) + 0.587 * parseInt(fg.slice(3, 5), 16) + 0.114 * parseInt(fg.slice(5, 7), 16);
  const contrast = Math.max(bgL, fgL) / Math.min(bgL, fgL);

  // Warmth (red+yellow vs blue+cyan)
  const accent = palette.accent || '#888888';
  const ar = parseInt(accent.slice(1, 3), 16);
  const ag = parseInt(accent.slice(3, 5), 16);
  const ab = parseInt(accent.slice(5, 7), 16);
  const warmth = ar > ab ? 'warm' : ar < ab ? 'cool' : 'neutral';

  return {
    diversity: hues.size,
    contrast: contrast > 10 ? 'high' : contrast > 5 ? 'medium' : 'low',
    warmth,
  };
}

const stats = inferStats(theme.palette);
---

<article
  class="group relative rounded-xl border border-border bg-surface transition-all duration-200 hover:border-accent/40 hover:shadow-lg hover:shadow-accent/5"
  aria-label={`Theme: ${theme.name} by ${theme.author}`}
  data-theme-card
  data-theme-name={theme.name.toLowerCase()}
  data-theme-author={theme.author.toLowerCase()}
  data-theme-mood={theme.mood.join(',')}
  data-theme-color={theme.color_family}
  data-theme-tags={theme.tags.join(',')}
>
  {/* Share button — positioned outside <a> for valid HTML */}
  <button
    type="button"
    class="absolute right-2 bottom-2 z-10 flex items-center gap-1 rounded-md bg-background/80 px-2 py-1 text-xs font-medium text-muted-foreground hover:text-foreground backdrop-blur-sm transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
    aria-label={`Copy link to ${theme.name}`}
    data-share-url={`${Astro.url.origin}${import.meta.env.BASE_URL}/themes/${theme.slug}`}
  >
    <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
    </svg>
    <span>Copy link</span>
  </button>

  <a
    href={`${import.meta.env.BASE_URL}/themes/${theme.slug}`}
    class="block focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-xl"
  >
    {/* Preview image */}
    <div class="relative aspect-[16/10] overflow-hidden rounded-t-xl bg-background">
      <img
        src={`${import.meta.env.BASE_URL}/themes/${theme.slug}/${theme.preview}`}
        alt={`Preview of ${theme.name} theme`}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
        decoding="async"
        width="640"
        height="400"
      />
      {/* Color family badge */}
      <span
        class="absolute right-2 top-2 flex items-center gap-1.5 rounded-full bg-background/80 px-2 py-0.5 text-[0.65rem] font-medium text-foreground backdrop-blur-sm"
      >
        <span
          class="inline-block h-2 w-2 rounded-full"
          style={`background-color: ${colorDots[theme.color_family] ?? '#71717a'}`}
          aria-hidden="true"
        ></span>
        {theme.color_family}
      </span>

      {/* Quick Look overlay on hover */}
      <div class="absolute inset-0 flex items-center justify-center bg-background/60 opacity-0 group-hover:opacity-100 transition-opacity duration-200 backdrop-blur-sm">
        <span class="text-sm font-medium text-foreground bg-surface/90 px-4 py-2 rounded-lg border border-border">
          Quick Look
        </span>
      </div>
    </div>

    <div class="p-4 space-y-3">
      {/* Title and author */}
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <h3 class="text-base font-semibold text-foreground group-hover:text-accent transition-colors duration-200 truncate">
            {theme.name}
          </h3>
          <p class="text-xs text-muted-foreground mt-0.5">by {theme.author}</p>
        </div>
      </div>

      {/* Palette grid */}
      <PaletteGrid palette={theme.palette} size="sm" />

      {/* Stats row */}
      <div class="flex items-center gap-3 text-[0.65rem] text-muted-foreground">
        <span class="flex items-center gap-1" title="Color diversity">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01"/>
          </svg>
          {stats.diversity} hues
        </span>
        <span class="flex items-center gap-1" title="Contrast ratio">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          {stats.contrast}
        </span>
        <span class="flex items-center gap-1" title="Color temperature">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
          {stats.warmth}
        </span>
      </div>

      {/* Mood tags */}
      <div class="flex flex-wrap gap-1.5">
        {theme.mood.map((tag) => (
          <span class="inline-flex items-center rounded-full bg-accent/10 px-2 py-0.5 text-[0.65rem] font-medium text-accent border border-accent/20">
            {tag}
          </span>
        ))}
      </div>
    </div>
  </a>
</article>
