---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found — Omarchy Quattro Marketplace">
  <section class="flex flex-col items-center justify-center py-24 text-center">
    <span class="text-6xl" aria-hidden="true">🔍</span>
    <h1 class="mt-6 text-4xl font-bold tracking-tight text-foreground">
      404 — Page Not Found
    </h1>
    <p class="mt-4 max-w-md text-lg text-muted-foreground">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a
      href={import.meta.env.BASE_URL}
      class="mt-8 inline-flex items-center gap-2 rounded-lg bg-accent px-6 py-3 text-sm font-medium text-accent-foreground transition-colors hover:bg-accent/90 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background"
    >
      <span aria-hidden="true">&larr;</span>
      Back to Marketplace
    </a>
  </section>
</Base>
