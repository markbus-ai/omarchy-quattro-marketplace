---
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import EmptyState from '../components/EmptyState.astro';
import SearchInput from '../components/SearchInput.astro';
import FilterBar from '../components/FilterBar.astro';
import FilterCount from '../components/FilterCount.astro';
import type { ThemeRegistry } from '../data/theme-schema';

const registry: ThemeRegistry = await import('../../registry.json').then(
  (m) => m.default,
);
---

<Base title="Omarchy Quattro Marketplace — Themes">
  <section class="space-y-8">
    {/* Hero */}
    <header class="space-y-3 pb-2">
      <h1 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
        Theme Marketplace
      </h1>
      <p class="max-w-2xl text-base text-muted-foreground">
        Browse and install themes for Omarchy 4. Each theme includes a complete
        24-color palette for your terminal, editor, and desktop.
      </p>
    </header>

    {/* Search and Filters — collapsed by default on mobile */}
    <div class="rounded-xl border border-border/50 bg-surface/50 p-4 sm:p-6">
      <SearchInput totalCount={registry.length} />
      <div class="mt-4">
        <FilterBar registry={registry} />
      </div>
      <FilterCount totalCount={registry.length} />
    </div>

    {/* Theme Grid */}
    {registry.length > 0 ? (
      <ul
        class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4"
        aria-label="Available themes"
        data-theme-grid
      >
        {registry.map((theme) => (
          <li data-theme-item>
            <ThemeCard theme={theme} />
          </li>
        ))}
      </ul>
    ) : (
      <EmptyState
        title="No themes yet"
        description="Themes will appear here once they are added to the registry."
        icon="🎨"
      />
    )}

    {/* Empty state for no search results (hidden by default) */}
    <div
      id="no-results"
      class="hidden"
    >
      <EmptyState
        title="No themes match your filters"
        description="Try adjusting your search or filter criteria."
        icon="🔍"
      />
    </div>
  </section>
</Base>

<script>
  function initFiltering() {
    const grid = document.querySelector('[data-theme-grid]');
    const noResults = document.getElementById('no-results');
    if (!grid || !noResults) return;

    const items = grid.querySelectorAll('[data-theme-item]');
    const cards = grid.querySelectorAll('[data-theme-card]');

    // Current filter state
    let currentFilters = {
      search: '',
      mood: [] as string[],
      colorFamily: [] as string[],
      tags: [] as string[],
    };

    document.addEventListener('filter-change', ((e: CustomEvent) => {
      // Merge the event detail into current filters
      if ('search' in e.detail) {
        currentFilters.search = e.detail.search;
      }
      if ('mood' in e.detail) {
        currentFilters.mood = e.detail.mood;
      }
      if ('colorFamily' in e.detail) {
        currentFilters.colorFamily = e.detail.colorFamily;
      }
      if ('tags' in e.detail) {
        currentFilters.tags = e.detail.tags;
      }

      applyFilters();
    }) as EventListener);

    function applyFilters() {
      let visibleCount = 0;

      cards.forEach((card, index) => {
        const el = card as HTMLElement;
        const name = el.dataset.themeName ?? '';
        const author = el.dataset.themeAuthor ?? '';
        const mood = (el.dataset.themeMood ?? '').split(',').filter(Boolean);
        const color = el.dataset.themeColor ?? '';
        const tags = (el.dataset.themeTags ?? '').split(',').filter(Boolean);

        let visible = true;

        // Search filter (matches name, author, or tags)
        if (currentFilters.search) {
          const query = currentFilters.search.toLowerCase();
          const matchesName = name.includes(query);
          const matchesAuthor = author.includes(query);
          const matchesTags = tags.some((t) => t.includes(query));
          if (!matchesName && !matchesAuthor && !matchesTags) {
            visible = false;
          }
        }

        // Mood filter (OR logic — theme must have at least one selected mood)
        if (visible && currentFilters.mood.length > 0) {
          if (!currentFilters.mood.some((m) => mood.includes(m))) {
            visible = false;
          }
        }

        // Color family filter (OR logic)
        if (visible && currentFilters.colorFamily.length > 0) {
          if (!currentFilters.colorFamily.includes(color)) {
            visible = false;
          }
        }

        // Tags filter (OR logic — theme must have at least one selected tag)
        if (visible && currentFilters.tags.length > 0) {
          if (!currentFilters.tags.some((t) => tags.includes(t))) {
            visible = false;
          }
        }

        // Apply visibility
        const item = items[index] as HTMLElement;
        if (visible) {
          item.hidden = false;
          el.removeAttribute('hidden');
          visibleCount++;
        } else {
          item.hidden = true;
          el.setAttribute('hidden', '');
        }
      });

      // Show/hide grid and no-results state
      const hasResults = visibleCount > 0;
      grid.classList.toggle('hidden', !hasResults);
      noResults.classList.toggle('hidden', hasResults);
    }
  }

  initFiltering();
  document.addEventListener('astro:page-load', initFiltering);
</script>
